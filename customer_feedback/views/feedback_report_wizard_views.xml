<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_feedback_report_wizard_form" model="ir.ui.view">
        <field name="name">feedback.report.wizard.form</field>
        <field name="model">feedback.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Feedback Report">
                <p>
                    Generate a customer feedback report covering rating by product,
                    reviews by month, customer satisfaction, rating distribution,
                    most/least reviewed products and pending moderation.
                    Leave the dates empty to include all reviews.
                </p>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export Excel"
                            class="btn-primary"/>
                    <button name="action_export_pdf" type="object" string="Export PDF"
                            class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_feedback_report_wizard" model="ir.actions.act_window">
        <field name="name">Export Reports</field>
        <field name="res_model">feedback.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
