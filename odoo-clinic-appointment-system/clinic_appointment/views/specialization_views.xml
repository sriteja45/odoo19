<odoo>

    <!-- List View -->
    <record id="view_clinic_specialization_list" model="ir.ui.view">
        <field name="name">clinic.specialization.list</field>
        <field name="model">clinic.specialization</field>
        <field name="arch" type="xml">
            <list string="Specializations">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_clinic_specialization_form" model="ir.ui.view">
        <field name="name">clinic.specialization.form</field>
        <field name="model">clinic.specialization</field>
        <field name="arch" type="xml">
            <form string="Specialization">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_clinic_specialization" model="ir.actions.act_window">
        <field name="name">Specializations</field>
        <field name="res_model">clinic.specialization</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>