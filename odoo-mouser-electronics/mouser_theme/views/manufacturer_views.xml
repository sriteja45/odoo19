<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mouser_manufacturer_list" model="ir.ui.view">
        <field name="name">mouser.manufacturer.list</field>
        <field name="model">mouser.manufacturer</field>
        <field name="arch" type="xml">
            <list string="Manufacturers">
                <field name="sequence"/>
                <field name="name"/>
                <field name="first_letter"/>
                <field name="product_count"/>
                <field name="is_published"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mouser_manufacturer_form" model="ir.ui.view">
        <field name="name">mouser.manufacturer.form</field>
        <field name="model">mouser.manufacturer</field>
        <field name="arch" type="xml">
            <form string="Manufacturer">
                <sheet>
                    <header>
                        <button name="action_sync_manufacturers_from_mouser" type="object" string="Sync from Mouser API" class="btn-primary"/>
                    </header>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="first_letter" readonly="1"/>
                        <field name="product_count" readonly="1"/>
                        <field name="mouser_api_source" readonly="1"/>
                        <field name="mouser_last_sync" readonly="1"/>
                        <field name="is_published"/>
                        <field name="active"/>
                    </group>

                    <group>
                        <field name="logo" widget="image"/>
                        <field name="banner_image" widget="image"/>
                    </group>

                    <notebook>
                        <page string="Website">
                            <group>
                                <field name="short_description"/>
                                <field name="website_description" widget="html"/>
                                <field name="category_ids" widget="many2many_tags"/>
                            </group>
                        </page>

                        <page string="Products">
                            <field name="product_tmpl_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mouser_manufacturer" model="ir.actions.act_window">
        <field name="name">Manufacturers</field>
        <field name="res_model">mouser.manufacturer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mouser_root"
              name="Mouser Theme"
              sequence="80"/>

    <menuitem id="menu_mouser_manufacturer"
              name="Manufacturers"
              parent="menu_mouser_root"
              action="action_mouser_manufacturer"
              sequence="10"/>

</odoo>