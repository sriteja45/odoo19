<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the existing list view (rating.rating_rating_view_tree) -->
    <record id="rating_rating_view_tree_inherit" model="ir.ui.view">
        <field name="name">rating.rating.list.extended</field>
        <field name="model">rating.rating</field>
        <field name="inherit_id" ref="rating.rating_rating_view_tree"/>
        <field name="arch" type="xml">
            <field name="rated_partner_id" position="after">
                <field name="is_verified_purchase" optional="show" widget="boolean_toggle"/>
                <field name="moderation_status" optional="show" widget="badge"
                       decoration-success="moderation_status == 'approved'"
                       decoration-warning="moderation_status == 'pending'"
                       decoration-danger="moderation_status == 'rejected'"/>
                <field name="helpful_count" optional="show" sum="Helpful"/>
                <field name="unhelpful_count" optional="hide"/>
                <field name="attachment_count" optional="show" string="Media"/>
                <field name="product_id" optional="hide"/>
                <field name="product_variant_display" optional="show" string="Variant"/>
                <field name="is_flagged_duplicate" optional="hide" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <!-- Extend the existing form view (rating.rating_rating_view_form) -->
    <record id="rating_rating_view_form_inherit" model="ir.ui.view">
        <field name="name">rating.rating.form.extended</field>
        <field name="model">rating.rating</field>
        <field name="inherit_id" ref="rating.rating_rating_view_form"/>
        <field name="arch" type="xml">
            <field name="is_internal" position="after">
                <field name="is_verified_purchase" widget="boolean_toggle" readonly="1"/>
                <field name="is_anonymous"/>
                <field name="product_id" options="{'no_create': True}"/>
                <field name="product_variant_display" readonly="1" invisible="not product_variant_display"/>
                <field name="is_flagged_duplicate" readonly="1" invisible="not is_flagged_duplicate"/>
                <field name="submission_ip" readonly="1" invisible="not submission_ip"/>
            </field>
            <field name="consumed" position="after">
                <field name="moderation_status" widget="radio" options="{'horizontal': true}"/>
                <field name="moderated_by_id" readonly="1" invisible="not moderated_by_id"/>
                <field name="moderated_date" readonly="1" invisible="not moderated_date"/>
                <field name="moderation_reason" invisible="moderation_status != 'rejected'"/>
                <label for="helpful_count" string="Votes"/>
                <div class="o_row">
                    <field name="helpful_count" readonly="1"/>
                    <span>helpful /</span>
                    <field name="unhelpful_count" readonly="1"/>
                    <span>not helpful</span>
                </div>
            </field>
            <!-- Media attachments notebook page for moderators -->
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Review Media" name="review_media">
                        <group>
                            <field name="attachment_count" readonly="1"/>
                        </group>
                        <field name="attachment_ids" mode="kanban" options="{'no_create_edit': True}">
                            <kanban>
                                <field name="id"/>
                                <field name="name"/>
                                <field name="mimetype"/>
                                <templates>
                                    <t t-name="card">
                                        <div class="oe_kanban_global_click d-flex flex-column align-items-center p-2" style="width:140px;">
                                            <img t-if="record.mimetype.raw_value and record.mimetype.raw_value.startsWith('image/')"
                                                 t-att-src="'/web/content/' + record.id.raw_value + '?download=false'"
                                                 alt=""
                                                 style="max-width:120px;max-height:90px;object-fit:contain;"/>
                                            <div t-elif="record.mimetype.raw_value and record.mimetype.raw_value.startsWith('video/')"
                                                 class="d-flex align-items-center justify-content-center bg-dark text-white"
                                                 style="width:120px;height:90px;">
                                                <i class="fa fa-play-circle fa-2x"/>
                                            </div>
                                            <div t-else=""
                                                 class="d-flex align-items-center justify-content-center bg-light"
                                                 style="width:120px;height:90px;">
                                                <i class="fa fa-file fa-2x text-muted"/>
                                            </div>
                                            <span class="text-truncate small mt-1" t-esc="record.name.value" style="max-width:120px;"/>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </page>
                </notebook>
            </xpath>
            <sheet position="before">
                <header>
                    <button name="action_approve_review" type="object" string="Approve"
                            class="oe_highlight" invisible="moderation_status == 'approved'"/>
                    <button name="action_reject_review" type="object" string="Reject"
                            invisible="moderation_status == 'rejected'"/>
                    <button name="action_reset_to_pending" type="object" string="Reset to Pending"
                            invisible="moderation_status == 'pending'"/>
                </header>
            </sheet>
        </field>
    </record>

    <!-- Extend the existing search view (rating.rating_rating_view_search) -->
    <record id="rating_rating_view_search_inherit" model="ir.ui.view">
        <field name="name">rating.rating.search.extended</field>
        <field name="model">rating.rating</field>
        <field name="inherit_id" ref="rating.rating_rating_view_search"/>
        <field name="arch" type="xml">
            <filter name="rating_happy" position="after">
                <separator/>
                <filter string="Verified Purchase" name="filter_verified_purchase"
                        domain="[('is_verified_purchase', '=', True)]"/>
                <separator/>
                <filter string="Pending Approval" name="filter_pending"
                        domain="[('moderation_status', '=', 'pending')]"/>
                <filter string="Approved" name="filter_approved"
                        domain="[('moderation_status', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected"
                        domain="[('moderation_status', '=', 'rejected')]"/>
                <separator/>
                <filter string="With Media" name="filter_with_media"
                        domain="[('attachment_count', '>', 0)]"/>
                <separator/>
                <filter string="Flagged Duplicate" name="filter_flagged_duplicate"
                        domain="[('is_flagged_duplicate', '=', True)]"/>
            </filter>
            <filter name="rating_text" position="after">
                <filter string="Moderation Status" name="group_moderation_status"
                        context="{'group_by': 'moderation_status'}"/>
            </filter>
        </field>
    </record>

    <!-- Extend the existing action to open on the moderation queue by default -->
    <record id="rating.rating_rating_action" model="ir.actions.act_window">
        <field name="context">{'search_default_filter_pending': 0}</field>
    </record>

    <!-- Dedicated shortcut for shop managers: pending reviews only.
         Reuses the exact same action/model, just pre-filtered - not a new screen. -->
    <record id="rating_rating_action_pending" model="ir.actions.act_window">
        <field name="name">Reviews Awaiting Moderation</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'product.template'), ('moderation_status', '=', 'pending')]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_review_moderation"
              name="Reviews to Moderate"
              parent="website_sale.menu_catalog"
              action="rating_rating_action_pending"
              sequence="95"/>

</odoo>
