<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- Tree View -->
    <!-- ================================================= -->

    <record id="view_profit_loss_tree" model="ir.ui.view">
        <field name="name">mouser.profit.loss.tree</field>
        <field name="model">mouser.profit.loss</field>
        <field name="arch" type="xml">

            <list string="Profit &amp; Loss">

                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="gross_profit"/>
                <field name="expenses"/>
                <field name="operating_profit"/>
                <field name="net_profit"/>
                <field name="profit_margin"/>

            </list>

        </field>
    </record>


    <!-- ================================================= -->
    <!-- Form View -->
    <!-- ================================================= -->

    <record id="view_profit_loss_form" model="ir.ui.view">
        <field name="name">mouser.profit.loss.form</field>
        <field name="model">mouser.profit.loss</field>
        <field name="arch" type="xml">

            <form string="Profit &amp; Loss">

                <header>

                    <button
                        name="action_generate_report"
                        string="Generate Report"
                        type="object"
                        class="btn-primary"/>

                </header>

                <sheet>

                    <group>
                        <field name="name" readonly="1"/>
                    </group>

                    <group>

                        <group string="Report Filters">

                            <field name="date_from"/>
                            <field name="date_to"/>

                        </group>

                        <group string="Report Summary">

                            <field name="gross_profit" readonly="1"/>
                            <field name="expenses" readonly="1"/>
                            <field name="operating_profit" readonly="1"/>
                            <field name="net_profit" readonly="1"/>
                            <field name="profit_margin" readonly="1"/>

                        </group>

                    </group>

                    <notebook>

                        <!-- ===================================== -->
                        <!-- Sales Orders -->
                        <!-- ===================================== -->

                        <page string="Sales Orders">

                            <field name="sale_order_ids" readonly="1">

                                <list>

                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>

                                </list>

                            </field>

                        </page>

                        <!-- ===================================== -->
                        <!-- Purchase Orders -->
                        <!-- ===================================== -->

                        <page string="Purchase Orders">

                            <field name="purchase_order_ids" readonly="1">

                                <list>

                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- ================================================= -->
    <!-- Action -->
    <!-- ================================================= -->

    <record id="action_profit_loss" model="ir.actions.act_window">

        <field name="name">Profit &amp; Loss</field>

        <field name="res_model">mouser.profit.loss</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>