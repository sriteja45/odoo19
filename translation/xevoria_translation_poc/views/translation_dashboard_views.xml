<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Queue dashboard views -->
    <record id="view_xevoria_translation_queue_graph" model="ir.ui.view">
        <field name="name">xevoria.translation.queue.graph</field>
        <field name="model">xevoria.translation.queue</field>
        <field name="arch" type="xml">
            <graph string="Queue Status" type="bar">
                <field name="state" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_xevoria_translation_queue_pivot" model="ir.ui.view">
        <field name="name">xevoria.translation.queue.pivot</field>
        <field name="model">xevoria.translation.queue</field>
        <field name="arch" type="xml">
            <pivot string="Queue Analysis">
                <field name="state" type="row"/>
                <field name="lang_id" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_xevoria_translation_queue_dashboard" model="ir.actions.act_window">
        <field name="name">Queue Dashboard</field>
        <field name="res_model">xevoria.translation.queue</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'group_by': ['state']}</field>
    </record>

    <!-- Translation quality dashboard views -->
    <record id="view_xevoria_product_translation_graph" model="ir.ui.view">
        <field name="name">xevoria.product.translation.poc.graph</field>
        <field name="model">xevoria.product.translation.poc</field>
        <field name="arch" type="xml">
            <graph string="Translation Review Status" type="bar">
                <field name="review_state" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_xevoria_product_translation_pivot" model="ir.ui.view">
        <field name="name">xevoria.product.translation.poc.pivot</field>
        <field name="model">xevoria.product.translation.poc</field>
        <field name="arch" type="xml">
            <pivot string="Translation Review Analysis">
                <field name="review_state" type="row"/>
                <field name="lang_id" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_xevoria_translation_quality_dashboard" model="ir.actions.act_window">
        <field name="name">Review Dashboard</field>
        <field name="res_model">xevoria.product.translation.poc</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'group_by': ['review_state']}</field>
    </record>

    <!-- Operational shortcuts -->
    <record id="action_xevoria_translation_failed_jobs" model="ir.actions.act_window">
        <field name="name">Failed Jobs</field>
        <field name="res_model">xevoria.translation.queue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','failed')]</field>
    </record>

    <record id="action_xevoria_translation_pending_review" model="ir.actions.act_window">
        <field name="name">Pending Review</field>
        <field name="res_model">xevoria.product.translation.poc</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('review_state','=','pending_review')]</field>
    </record>

    <!-- Production validation wizard -->
    <record id="view_xevoria_translation_validation_wizard_form" model="ir.ui.view">
        <field name="name">xevoria.translation.validation.wizard.form</field>
        <field name="model">xevoria.translation.validation.wizard</field>
        <field name="arch" type="xml">
            <form string="Production Validation">
                <sheet>
                    <group>
                        <group>
                            <field name="lang_id"/>
                            <field name="sample_limit"/>
                        </group>
                        <group>
                            <field name="include_catalog"/>
                            <field name="include_seo"/>
                            <field name="include_search_terms"/>
                            <field name="include_rtl_hint"/>
                        </group>
                    </group>
                    <separator string="Result"/>
                    <field name="result_html" readonly="1" nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_run_validation" type="object" string="Run Validation" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_xevoria_translation_validation_wizard" model="ir.actions.act_window">
        <field name="name">Production Validation</field>
        <field name="res_model">xevoria.translation.validation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_xevoria_translation_dashboard" name="Dashboard" parent="menu_xevoria_translation_root" sequence="1"/>
    <menuitem id="menu_xevoria_translation_queue_dashboard" name="Queue Dashboard" parent="menu_xevoria_translation_dashboard" action="action_xevoria_translation_queue_dashboard" sequence="10"/>
    <menuitem id="menu_xevoria_translation_review_dashboard" name="Review Dashboard" parent="menu_xevoria_translation_dashboard" action="action_xevoria_translation_quality_dashboard" sequence="20"/>
    <menuitem id="menu_xevoria_translation_failed_jobs" name="Failed Jobs" parent="menu_xevoria_translation_dashboard" action="action_xevoria_translation_failed_jobs" sequence="30"/>
    <menuitem id="menu_xevoria_translation_pending_review" name="Pending Review" parent="menu_xevoria_translation_dashboard" action="action_xevoria_translation_pending_review" sequence="40"/>
    <menuitem id="menu_xevoria_translation_validation" name="Production Validation" parent="menu_xevoria_translation_root" action="action_xevoria_translation_validation_wizard" sequence="90"/>

    <!-- Step 42: Queue progress dashboard with status cards and progress percentage -->
    <record id="view_xevoria_translation_queue_progress_dashboard_form" model="ir.ui.view">
        <field name="name">xevoria.translation.queue.dashboard.form</field>
        <field name="model">xevoria.translation.queue.dashboard</field>
        <field name="arch" type="xml">
            <form string="Queue Progress Dashboard" create="0" edit="0" delete="0">
                <header>
                    <button name="action_process_pending_jobs" type="object" string="Process Next Batch" class="btn-primary"/>
                    <button name="action_cancel_pending_jobs" type="object" string="Cancel Pending"/>
                    <button name="action_refresh_dashboard" type="object" string="Refresh"/>
                    <button name="action_open_all_jobs" type="object" string="Open All Jobs"/>
                    <button name="action_open_failed_jobs" type="object" string="Open Failed Jobs"/>
                </header>
                <sheet>
                    <field name="dashboard_html" nolabel="1" readonly="1"/>
                    <group string="Progress Summary" col="4">
                        <field name="total_jobs" readonly="1"/>
                        <field name="completed_jobs" readonly="1"/>
                        <field name="remaining_jobs" readonly="1"/>
                        <field name="progress_percent" widget="progressbar" readonly="1"/>
                        <field name="configured_batch_size" readonly="1"/>
                    </group>
                    <group string="Open by Status" col="4">
                        <button name="action_open_pending_jobs" type="object" string="Pending" class="oe_stat_button" icon="fa-clock-o"/>
                        <button name="action_open_running_jobs" type="object" string="Running" class="oe_stat_button" icon="fa-refresh"/>
                        <button name="action_open_completed_jobs" type="object" string="Completed" class="oe_stat_button" icon="fa-check"/>
                        <button name="action_open_failed_jobs" type="object" string="Failed" class="oe_stat_button" icon="fa-warning"/>
                    </group>
                    <group string="Detailed Counts" col="4">
                        <field name="pending_jobs" readonly="1"/>
                        <field name="running_jobs" readonly="1"/>
                        <field name="completed_jobs" readonly="1"/>
                        <field name="failed_jobs" readonly="1"/>
                        <field name="cancelled_jobs" readonly="1"/>
                        <field name="progress_label" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_xevoria_translation_queue_progress_dashboard" model="ir.actions.act_window">
        <field name="name">Queue Progress Dashboard</field>
        <field name="res_model">xevoria.translation.queue.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_xevoria_translation_queue_progress_dashboard" name="Queue Progress" parent="menu_xevoria_translation_dashboard" action="action_xevoria_translation_queue_progress_dashboard" sequence="5"/>

</odoo>
