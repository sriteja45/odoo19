                        </div>
                    </section>

                    <t t-foreach="regions" t-as="region">
                        <section class="local-region">
                            <h2 t-out="region['title']"/>
                            <div class="country-grid">
                                <t t-foreach="region['countries']" t-as="country">
                                    <div class="local-country">
                                        <span class="flag-box" t-out="country['flag']"/>
                                        <div>
                                            <a class="country-name" href="#" t-out="country['name']"/>
                                            <div class="currency-row">
                                                <t t-foreach="country['currencies']" t-as="cur">
                                                    <a href="#" t-out="cur"/><span class="cur-sep">|</span>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </section>
                    </t>
                </main>

                <section class="newsletter"><h3>Get the Latest News</h3><div><input placeholder="Enter your Email"/><button>Subscribe</button></div></section>
