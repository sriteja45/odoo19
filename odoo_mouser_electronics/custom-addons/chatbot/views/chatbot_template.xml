<?xml version="1.0" encoding="utf-8"?>

<odoo>

<template
id="chatbot_widget"
inherit_id="website.layout">

<xpath
expr="//div[@id='wrapwrap']"
position="inside">

<div id="my_chat_container">

<!-- OPEN CHAT -->

<button
id="my_chat_icon"
class="chat-toggle-btn"
type="button">

<span class="chat-icon">

💬

</span>

</button>



<!-- CHAT WINDOW -->

<div
id="my_chat_window"
class="chat-window">



<!-- HEADER -->

<div
class="chat-header">

<h3>

Xevoria Assistant

</h3>

<button
id="chat_close_btn"
class="close-btn"
type="button">

✕

</button>

</div>



<!-- CHAT BODY -->

<div
id="chat_messages"
class="chat-messages">


<div
class="chat-message bot-message">

<p>

👋 Hello!

<br/>

Welcome to Xevoria Electronics.

</p>

</div>

</div>



<!-- INPUT -->

<div

class="chat-input-area"

style="
display:flex;
align-items:center;
gap:8px;
padding:10px;
"

>


<div

style="
position:relative;
flex:1;
"

>


<input

id="chat_input"

class="chat-input"

type="text"

placeholder="Type or speak..."

autocomplete="off"

style="
width:100%;
padding-right:45px;
"

/>



<!-- VOICE -->

<button

id="chat_mic_btn"

type="button"

title="Voice Search"

style="
position:absolute;

right:10px;

top:50%;

transform:translateY(-50%);

border:none;

background:transparent;

cursor:pointer;

font-size:18px;

padding:0;
"

>

🎙️

</button>


</div>



<!-- SEND -->

<button

id="chat_send_btn"

class="send-btn"

type="button">

Send

</button>


</div>


</div>


</div>


</xpath>

</template>

</odoo>