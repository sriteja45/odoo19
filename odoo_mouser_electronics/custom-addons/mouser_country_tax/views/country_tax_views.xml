<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_country_tax_tree" model="ir.ui.view">
        <field name="name">mouser.country.tax.tree</field>
        <field name="model">mouser.country.tax</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id"/>
                <field name="tax_percent"/>
            </list>
        </field>
    </record>

    <record id="view_country_tax_form" model="ir.ui.view">
        <field name="name">mouser.country.tax.form</field>
        <field name="model">mouser.country.tax</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="country_id"/>
                        <field name="tax_percent"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_country_tax" model="ir.actions.act_window">
        <field name="name">Country Tax Rules</field>
        <field name="res_model">mouser.country.tax</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>