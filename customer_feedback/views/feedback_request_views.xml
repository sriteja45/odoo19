<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_feedback_request_list" model="ir.ui.view">
        <field name="name">feedback.request.list</field>
        <field name="model">feedback.request</field>
        <field name="arch" type="xml">
            <list string="Feedback Requests" decoration-muted="status=='expired'"
                  decoration-success="status=='submitted'" decoration-info="status=='sent'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <field name="delivery_date"/>
                <field name="expiry_date"/>
                <field name="invitation_email_status" widget="badge"/>
                <field name="reminder_email_status" widget="badge"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_feedback_request_form" model="ir.ui.view">
        <field name="name">feedback.request.form</field>
        <field name="model">feedback.request</field>
        <field name="arch" type="xml">
            <form string="Feedback Request">
                <header>
                    <button name="action_send_invitation" string="Send Invitation Now" type="object"
                            class="oe_highlight" invisible="status != 'pending'"/>
                    <button name="action_send_reminder" string="Send Reminder Now" type="object"
                            invisible="status != 'sent' or reminder_sent"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,sent,submitted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="sale_order_id"/>
                            <field name="picking_id"/>
                        </group>
                        <group>
                            <field name="token" readonly="1"/>
                            <field name="delivery_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group string="Email Delivery">
                        <group>
                            <field name="invitation_email_status" widget="badge" readonly="1"/>
                            <field name="invitation_retry_count" readonly="1"/>
                            <field name="invitation_sent_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="reminder_email_status" widget="badge" readonly="1"/>
                            <field name="reminder_retry_count" readonly="1"/>
                            <field name="reminder_sent" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Review">
                            <field name="review_ids" readonly="1">
                                <list>
                                    <field name="rating"/>
                                    <field name="review_title"/>
                                    <field name="review_text"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_feedback_request_search" model="ir.ui.view">
        <field name="name">feedback.request.search</field>
        <field name="model">feedback.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <filter string="Pending" name="pending" domain="[('status','=','pending')]"/>
                <filter string="Sent" name="sent" domain="[('status','=','sent')]"/>
                <filter string="Submitted" name="submitted" domain="[('status','=','submitted')]"/>
                <filter string="Expired" name="expired" domain="[('status','=','expired')]"/>
                <filter string="Invitation Failed" name="invitation_failed"
                        domain="[('invitation_email_status','=','failed')]"/>
                <filter string="Reminder Failed" name="reminder_failed"
                        domain="[('reminder_email_status','=','failed')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_feedback_request" model="ir.actions.act_window">
        <field name="name">Feedback Requests</field>
        <field name="res_model">feedback.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
