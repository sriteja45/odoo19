<odoo>
    <template id="report_clinic_call_history">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>
                        <t t-esc="data.get('report_title', 'Call History') if data else 'Call History'"/>
                    </h2>

                    <table class="table table-sm table-bordered" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Channel</th>
                                <th>User</th>
                                <th>Partner</th>
                                <th>Call Date &amp; Time</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="rec">
                                <tr>
                                    <td><span t-esc="rec.name"/></td>
                                    <td><span t-esc="rec.channel_id.display_name or ''"/></td>
                                    <td><span t-esc="rec.user_id.name or ''"/></td>
                                    <td><span t-esc="rec.partner_id.name or ''"/></td>
                                    <td><span t-esc="rec.call_datetime or ''"/></td>
                                    <td><span t-esc="rec.duration_text or ''"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>