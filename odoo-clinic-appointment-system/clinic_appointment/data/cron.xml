<odoo> 
 
    <record id="ir_cron_followup_reminder" model="ir.cron"> 
        <field name="name">Clinic Follow-up Reminder</field> 
        <field name="model_id" ref="model_clinic_appointment"/> 
        <field name="state">code</field> 
        <field name="code">model.cron_send_followup_reminders()</field> 
 
        <!-- Run once per day --> 
        <field name="interval_number">1</field> 
        <field name="interval_type">days</field> 
 
        <!-- Active --> 
        <field name="active">True</field> 
    </record>
</odoo>
