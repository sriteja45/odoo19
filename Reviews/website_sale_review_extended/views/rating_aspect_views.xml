<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rating_aspect_view_tree" model="ir.ui.view">
        <field name="name">rating.aspect.list</field>
        <field name="model">rating.aspect</field>
        <field name="arch" type="xml">
            <list string="Review Aspects">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category" optional="show"/>
                <field name="public_category_ids" widget="many2many_tags" optional="show"/>
                <field name="aspect_rating_count" string="Ratings Given" optional="show"/>
                <field name="active" optional="hide" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="rating_aspect_view_form" model="ir.ui.view">
        <field name="name">rating.aspect.form</field>
        <field name="model">rating.aspect</field>
        <field name="arch" type="xml">
            <form string="Review Aspect">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="aspect_rating_count" invisible="1"/>
                    </div>
                    <group>
                        <field name="name" placeholder="e.g. Comfort, Build Quality, Battery Life"/>
                        <field name="category"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="public_category_ids" widget="many2many_tags"
                               placeholder="Applies to every product if left empty"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rating_aspect_view_search" model="ir.ui.view">
        <field name="name">rating.aspect.search</field>
        <field name="model">rating.aspect</field>
        <field name="arch" type="xml">
            <search string="Review Aspects">
                <field name="name"/>
                <field name="category"/>
                <field name="public_category_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category Label" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rating_aspect_action" model="ir.actions.act_window">
        <field name="name">Review Aspects</field>
        <field name="res_model">rating.aspect</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define an aspect shoppers can rate on top of the overall stars
            </p>
            <p>
                E.g. "Comfort" for furniture, "Battery Life" for electronics.
                Configure which website categories ask about it, or leave it
                unrestricted to apply it to every product.
            </p>
        </field>
    </record>

    <menuitem id="menu_review_aspects"
              name="Review Aspects"
              parent="website_sale.menu_catalog"
              action="rating_aspect_action"
              sequence="96"/>

</odoo>
