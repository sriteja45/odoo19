<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_feedback" model="ir.module.category">
        <field name="name">Customer Feedback</field>
        <field name="sequence">20</field>
    </record>

    <record id="groups_privilege_feedback" model="res.groups.privilege">
        <field name="name">Customer Feedback</field>
        <field name="category_id" ref="module_category_feedback"/>
    </record>

    <record id="group_feedback_user" model="res.groups">
        <field name="name">Feedback User (Read Only)</field>
        <field name="privilege_id" ref="groups_privilege_feedback"/>
    </record>

    <record id="group_feedback_moderator" model="res.groups">
        <field name="name">Feedback Moderator</field>
        <field name="privilege_id" ref="groups_privilege_feedback"/>
        <field name="implied_ids" eval="[(4, ref('group_feedback_user'))]"/>
        <field name="comment">Can read all reviews and approve, reject, hide, or restore them.
Cannot delete reviews, configure the module, or manage the scheduler/email templates
(SRS Section 9/17: "Review Moderator" actor).</field>
    </record>

    <record id="group_feedback_manager" model="res.groups">
        <field name="name">Feedback Administrator</field>
        <field name="privilege_id" ref="groups_privilege_feedback"/>
        <field name="implied_ids" eval="[(4, ref('group_feedback_moderator'))]"/>
    </record>

    <record id="feedback_review_rule_manager" model="ir.rule">
        <field name="name">Feedback Manager: full access</field>
        <field name="model_id" ref="model_feedback_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_feedback_manager'))]"/>
    </record>

    <record id="feedback_review_rule_moderator" model="ir.rule">
        <field name="name">Feedback Moderator: see and moderate all reviews</field>
        <field name="model_id" ref="model_feedback_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_feedback_moderator'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="feedback_request_rule_moderator" model="ir.rule">
        <field name="name">Feedback Moderator: read all feedback requests</field>
        <field name="model_id" ref="model_feedback_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_feedback_moderator'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="feedback_review_rule_user" model="ir.rule">
        <field name="name">Feedback User: read approved and own</field>
        <field name="model_id" ref="model_feedback_review"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('status', '=', 'approved'), ('customer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_feedback_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="feedback_review_rule_portal" model="ir.rule">
        <field name="name">Portal: own reviews only</field>
        <field name="model_id" ref="model_feedback_review"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), ('customer_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="feedback_review_rule_user_company" model="ir.rule">
        <field name="name">Feedback User: company isolation</field>
        <field name="model_id" ref="model_feedback_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_feedback_user'))]"/>
    </record>

    <record id="feedback_request_rule_user_company" model="ir.rule">
        <field name="name">Feedback User: request company isolation</field>
        <field name="model_id" ref="model_feedback_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_feedback_user'))]"/>
    </record>

    <record id="feedback_request_rule_sales_company" model="ir.rule">
        <field name="name">Sales: feedback request company isolation</field>
        <field name="model_id" ref="model_feedback_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="feedback_review_rule_sales_company" model="ir.rule">
        <field name="name">Sales: review company isolation</field>
        <field name="model_id" ref="model_feedback_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>


    <record id="feedback_vote_rule_manager_company" model="ir.rule">
        <field name="name">Feedback Vote: company isolation</field>
        <field name="model_id" ref="model_feedback_review_vote"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_feedback_manager')), (4, ref('group_feedback_moderator')), (4, ref('group_feedback_user'))]"/>
    </record>

</odoo>
