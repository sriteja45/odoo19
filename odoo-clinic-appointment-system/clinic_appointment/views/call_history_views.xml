<odoo>

    <!-- List View -->
    <record id="view_clinic_call_history_list" model="ir.ui.view">
        <field name="name">clinic.call.history.list</field>
        <field name="model">clinic.call.history</field>
        <field name="arch" type="xml">
            <list string="Call History">
                <field name="name"/>
                <field name="channel_id"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="call_datetime"/>
                <field name="duration_seconds"/>
                <field name="duration_text"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_clinic_call_history_form" model="ir.ui.view">
        <field name="name">clinic.call.history.form</field>
        <field name="model">clinic.call.history</field>
        <field name="arch" type="xml">
            <form string="Call History">
                <header>
                    <button name="%(action_report_clinic_call_history)d"
                            string="Print PDF"
                            type="action"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="channel_id"/>
                            <field name="message_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="call_datetime"/>
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="duration_seconds"/>
                            <field name="duration_text"/>
                        </group>
                    </group>

                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_clinic_call_history" model="ir.actions.act_window">
        <field name="name">Call History</field>
        <field name="res_model">clinic.call.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_clinic_call_history"
              name="Call History"
              parent="clinic_root_menu"
              action="action_clinic_call_history"
              sequence="60"/>

</odoo>