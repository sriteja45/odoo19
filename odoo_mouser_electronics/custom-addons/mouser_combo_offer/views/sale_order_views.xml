<?xml version="1.0" encoding="utf-8"?>

<odoo>

<record
id="sale_order_combo"
model="ir.ui.view">

<field name="name">
sale.order.combo
</field>

<field name="model">
sale.order
</field>

<field
name="inherit_id"
ref="sale.view_order_form"/>

<field
name="arch"
type="xml">

<xpath
expr="//header"
position="inside">

<button
name="action_apply_combo_offer"
