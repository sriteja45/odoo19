<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action -->
    <record id="action_country_tax" model="ir.actions.act_window">
        <field name="name">Country Tax Rules</field>
        <field name="res_model">mouser.country.tax</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Root App Menu -->
    <menuitem
        id="menu_mouser_tax_root"
        name="Mouser Tax"
        sequence="5"
        web_icon="base,static/description/icon.png"/>

    <!-- Child Menu -->
    <menuitem
        id="menu_country_tax"
        name="Country Tax Rules"
        parent="menu_mouser_tax_root"
        action="action_country_tax"
        sequence="1"/>

</odoo>