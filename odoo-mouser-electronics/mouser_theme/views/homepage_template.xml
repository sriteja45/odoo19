<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mouser_homepage" name="Mouser Electronics Style Homepage">
        <t t-call="website.layout">
            <div id="wrap" class="mouser-homepage">
                
                <!-- Mouser original-style Order Preference popup -->
                <div class="mouser-order-pref-overlay" id="mouserOrderPreference" role="dialog" aria-modal="true" aria-labelledby="mouserOrderPreferenceTitle">
                    <div class="mouser-order-pref-modal">
                        <div class="mouser-order-pref-header">
                            <h2 id="mouserOrderPreferenceTitle">Order preference</h2>
                            <button type="button" class="mouser-order-pref-close" aria-label="Close order preference">×</button>
                        </div>
                        <div class="mouser-order-pref-body">
                            <p class="mouser-order-pref-intro">Please select how you would like to order from Mouser:</p>
                            <a class="mouser-order-pref-learn" href="/help/orders-shipping/gst-bill-format">Learn more about ordering from Mouser</a>
                            <label class="mouser-order-option">
                                <input type="radio" name="mouser_order_preference" value="standard_invoice"/>
                                <span>Standard Invoice</span>
                            </label>
                            <ul class="mouser-order-pref-list">
                                <li>Credit card (INR or USD)</li>
                                <li>Business Invoice (USD only)</li>
                            </ul>
                            <label class="mouser-order-option">
                                <input type="radio" name="mouser_order_preference" value="gst_business_invoice"/>
                                <span>GST Business Invoice (INR only)</span>
                            </label>
                            <ul class="mouser-order-pref-list">
                                <li>Must have valid GSTIN.</li>
                                <li>Credit cards NOT accepted.</li>
                            </ul>
                        </div>
                        <div class="mouser-order-pref-footer">
                            <button type="button" class="mouser-order-pref-cancel">Cancel</button>
                            <button type="button" class="mouser-order-pref-save">Save</button>
                        </div>
                    </div>
                </div>

                <section class="mouser-topline">
                    <div class="mouser-shell">
                        <div class="mouser-topline-left">
                            <a href="/about-tti" class="tti-top-link">Part of the TTI Family of Specialists</a><span class="sep">|</span>
                            <a href="tel:08042650011"><i class="fa fa-phone"></i> Contact Mouser (Bangalore) 080 42650011</a><span class="sep">|</span>
                            <a href="/feedback"><i class="fa fa-external-link"></i> Feedback</a>
                        </div>
                        <div class="mouser-topline-right">
                            <a href="/cs/localsites/">Change Location</a><span class="flag">🇮🇳</span><span>English</span><span>₹ INR <i class="fa fa-angle-down"></i></span>
                        </div>
                    </div>
                </section>

                <section class="mouser-header-main">
                    <div class="mouser-shell header-row">
                        <a class="mouser-logo" href="/mouser-home">
    <img src="/mouser_theme/static/src/img/custom_logo.webp"
         alt="Logo"
         style="height:60px; width:auto;"/>
</a>
                        <div class="search-area">
                            <!-- wrapper gives position:relative so panel can escape search-box overflow:hidden -->
                            <div class="mh-search-wrap">
                                <div class="search-box">
                                    <button id="mh-search-filter-btn" type="button" aria-haspopup="true" aria-expanded="false">All <i class="fa fa-angle-down"></i></button>
                                    <input id="mh-search-input" placeholder="Part No. / Keyword"/>
                                    <a class="search-btn" href="#"><i class="fa fa-search"></i></a>
                                </div>
                                <div id="mh-search-filter-panel" class="mh-search-filter-panel" style="display:none;">
                                    <div class="mh-filter-title">Filter your search</div>
                                    <div class="mh-filter-cols">
                                        <ul>
                                            <li><a href="#" data-filter="All">All</a></li>
                                            <li><a href="#" data-filter="Capacitors">Capacitors</a></li>
                                            <li><a href="#" data-filter="Circuit Protection">Circuit Protection</a></li>
                                            <li><a href="#" data-filter="Computing">Computing</a></li>
                                            <li><a href="#" data-filter="Connectors">Connectors</a></li>
                                            <li><a href="#" data-filter="Diodes &amp; Rectifiers">Diodes &amp; Rectifiers</a></li>
                                            <li><a href="#" data-filter="Embedded Processors &amp; Controllers">Embedded Processors &amp; Controllers</a></li>
                                            <li><a href="#" data-filter="Embedded Solutions">Embedded Solutions</a></li>
                                            <li><a href="#" data-filter="EMI/RFI Components">EMI/RFI Components</a></li>
                                            <li><a href="#" data-filter="Enclosures">Enclosures</a></li>
                                            <li><a href="#" data-filter="Engineering Development Tools">Engineering Development Tools</a></li>
                                        </ul>
                                        <ul>
                                            <li><a href="#" data-filter="Frequency Control &amp; Timing Devices">Frequency Control &amp; Timing Devices</a></li>
                                            <li><a href="#" data-filter="Inductors">Inductors</a></li>
                                            <li><a href="#" data-filter="Industrial Automation">Industrial Automation</a></li>
                                            <li><a href="#" data-filter="Integrated Circuits - ICs">Integrated Circuits - ICs</a></li>
                                            <li><a href="#" data-filter="Memory &amp; Data Storage">Memory &amp; Data Storage</a></li>
                                            <li><a href="#" data-filter="Microcontrollers - MCU">Microcontrollers - MCU</a></li>
                                            <li><a href="#" data-filter="MOSFETs">MOSFETs</a></li>
                                            <li><a href="#" data-filter="Opto-electronics">Opto-electronics</a></li>
                                            <li><a href="#" data-filter="Potentiometers">Potentiometers</a></li>
                                            <li><a href="#" data-filter="Power">Power</a></li>
                                            <li><a href="#" data-filter="Relays">Relays</a></li>
                                        </ul>
                                        <ul>
                                            <li><a href="#" data-filter="Resistors">Resistors</a></li>
                                            <li><a href="#" data-filter="Semiconductors">Semiconductors</a></li>
                                            <li><a href="#" data-filter="Sensors">Sensors</a></li>
                                            <li><a href="#" data-filter="Switches">Switches</a></li>
                                            <li><a href="#" data-filter="Test &amp; Measurement">Test &amp; Measurement</a></li>
                                            <li><a href="#" data-filter="Thermal Management">Thermal Management</a></li>
                                            <li><a href="#" data-filter="Thermistors">Thermistors</a></li>
                                            <li><a href="#" data-filter="Tools &amp; Supplies">Tools &amp; Supplies</a></li>
                                            <li><a href="#" data-filter="Transformers">Transformers</a></li>
                                            <li><a href="#" data-filter="Transistors">Transistors</a></li>
                                            <li><a href="#" data-filter="Varistors">Varistors</a></li>
                                            <li><a href="#" data-filter="Wire &amp; Cable">Wire &amp; Cable</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <label><input type="checkbox"/> In Stock</label><label><input type="checkbox"/> RoHS</label>
                        </div>
                    </div>
                </section>

                <section class="mouser-blue-nav">
                    <div class="mouser-shell nav-row">
                        <nav><a class="active" href="#">Products</a><a href="/manufacturer/">Manufacturers</a><a href="/services-tools">Services &amp; Tools</a><a href="#resources">Technical Resources</a><a href="#">Help</a></nav>
                        <div class="nav-actions">
                            <!-- Account & Orders dropdown -->
                            <div class="mh-account-wrap">
                                <a class="mh-account-btn" href="#" id="mouserAccountBtn">
                                    Account &amp; Orders <i class="fa fa-angle-down"></i>
                                </a>
                                <div class="mh-account-dropdown" id="mouserAccountDropdown">
                                    <a class="mh-login-btn" href="/services-tools/login">Log In</a>
                                    <p class="mh-new-cust">New customer? <a href="/MyAccount/Create">Start here</a></p>
                                    <a class="mh-order-hist" href="/account/orders">Order History</a>
                                </div>
                            </div>
                            <!-- Cart dropdown -->
                            <div class="mh-cart-wrap">
                                <a class="cart mh-cart-btn" href="#" id="mouserCartBtn">
                                    <i class="fa fa-shopping-cart"></i><span class="mh-cart-count">0</span>
                                </a>
                                <div class="mh-cart-dropdown" id="mouserCartDropdown">
                                    <table class="mh-cart-table">
                                        <thead>
                                            <tr>
                                                <th>Mfr.</th>
                                                <th>Mfr. No:</th>
                                                <th>Qty</th>
                                                <th>Ext Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td colspan="4" class="mh-cart-empty">Your basket is empty.</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div class="mh-cart-footer">
                                        <a class="mh-view-basket" href="/shop/cart">View Basket</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="mouser-shell main-area">
                    <aside class="left-menu">
                        <ul>
                            <t t-foreach="categories" t-as="cat">
                                <li><a t-att-href="'/c/' + cat.get('slug','') + '/'" t-att-title="cat.get('name','')">
                                    <span t-out="cat.get('name','')"/>
                                    <i class="fa fa-angle-right"></i>
                                </a></li>
                            </t>
                            <li class="viewall"><a href="/electronic-components">View All Products</a></li>
                        </ul>
                    </aside>
                    <main class="right-content">
                        <div class="black-strip">The Newest Products for Your Newest Designs®</div>
                        <section class="mouser-home-slider" data-autoplay="true" data-interval="3500">
                            <a class="mh-slide active" href="/quality" aria-label="Trust the source. Choose Mouser">
                                <img src="/mouser_theme/static/img/mouser-hp-bn-lg-authenticallyblue-en.webp" alt="Trust the source. Choose Mouser" loading="eager"/>
                            </a>
                            <a class="mh-slide" href="/automation-india-expo/" aria-label="Visit Mouser at Automation Expo 2026">
                                <img src="/mouser_theme/static/img/mouser-hp-bn-lg-automationexpo-2026-en.webp" alt="Visit Mouser at Automation Expo 2026" loading="lazy"/>
                            </a>
                            <a class="mh-slide" href="/c/semiconductors/" aria-label="The widest selection of semiconductors">
                                <img src="/mouser_theme/static/img/mouser-hp-bn-lg-widestselection-semiconductors-en.webp" alt="The widest selection of semiconductors" loading="lazy"/>
                            </a>
                            <a class="mh-slide" href="/manufacturer/te-connectivity/" aria-label="Your authorized source for the widest selection of TE products">
                                <img src="/mouser_theme/static/img/mouser-hp-bn-lg-te-en.webp" alt="Your authorized source for the widest selection of TE products" loading="lazy"/>
                            </a>
                            <div class="mh-controls" aria-label="Homepage banner carousel controls">
                                <button type="button" class="mh-pause" aria-label="Pause slideshow"><i class="fa fa-play"></i></button>
                                <button type="button" class="mh-dot active" data-slide="0" aria-label="Show banner 1"></button>
                                <button type="button" class="mh-dot" data-slide="1" aria-label="Show banner 2"></button>
                                <button type="button" class="mh-dot" data-slide="2" aria-label="Show banner 3"></button>
                                <button type="button" class="mh-dot" data-slide="3" aria-label="Show banner 4"></button>
                            </div>
                        </section>


                        <section class="home-section newest-section">
                            <div class="section-head"><h2>NEWEST PRODUCTS</h2><a href="/new">View All Newest Products</a></div>
                            <div class="product-strip">
                                <button class="slide-arrow left"><i class="fa fa-chevron-left"></i></button>
                                <t t-foreach="newest_products" t-as="p">
                                    <article class="new-card original-product-card">
                                        <div class="original-product-img-wrap">
                                            <img class="original-product-img" t-att-src="p.get('img')" t-att-alt="p['name']"/>
                                        </div>
                                        <a class="mouser-only-product-name" t-att-href="p.get('url', '#')" t-out="p['name']"/>
                                    </article>
                                </t>
                                <button class="slide-arrow right"><i class="fa fa-chevron-right"></i></button>
                            </div>
                        </section>
                    </main>
                </div>

                <section class="home-section manufacturers-section original-featured-manufacturers">
                    <div class="mouser-shell">
                        <div class="section-head">
                            <h2>Featured Manufacturers</h2>
                            <a href="/manufacturer/">View All Manufacturers</a>
                        </div>
                        <div class="brand-row">
                            <a class="brand-item" href="/manufacturer/analog-devices/"><img src="/mouser_theme/static/src/img/brand_analog.png?v=featured-original-logos-v1" alt="Analog Devices"/></a>
                            <a class="brand-item" href="/manufacturer/coilcraft/"><img src="/mouser_theme/static/src/img/brand_coilcraft.png?v=featured-original-logos-v1" alt="Coilcraft"/></a>
                            <a class="brand-item" href="/manufacturer/amd/"><img src="/mouser_theme/static/src/img/brand_amd.png?v=featured-original-logos-v1" alt="AMD"/></a>
                            <a class="brand-item" href="/manufacturer/te-connectivity/"><img src="/mouser_theme/static/src/img/brand_te.png?v=featured-original-logos-v1" alt="TE Connectivity"/></a>
                            <a class="brand-item" href="/manufacturer/infineon/"><img src="/mouser_theme/static/src/img/brand_infineon.png?v=featured-original-logos-v1" alt="Infineon"/></a>
                            <a class="brand-item" href="/manufacturer/tdk/"><img src="/mouser_theme/static/src/img/brand_tdk.png?v=featured-original-logos-v1" alt="TDK"/></a>
                        </div>
                    </div>
                </section>

                <section id="services-tools" class="home-section soft services-original"><div class="mouser-shell"><div class="section-head"><h2>Services &amp; Tools</h2><a href="/services-tools">View All Services &amp; Tools</a></div><div class="circle-row"><t t-foreach="services_tools" t-as="s"><a class="circle-card" t-att-href="s['url']"><img class="service-circle-img" t-att-src="s['img']" t-att-alt="s['title']"/><h3 t-out="s['title']"/><p t-out="s['desc']"/></a></t></div></div></section>

                <section class="home-section popular"><div class="mouser-shell"><div class="section-head"><h2>POPULAR CATEGORIES</h2><a href="/electronic-components">View All Product Categories</a></div><p class="popular-note">Mouser Electronics stocks the world’s widest selection of semiconductors and electronic components.</p><div class="popular-links"><t t-foreach="popular_categories" t-as="pc"><a t-att-href="pc['url']" t-out="pc['name']"/></t></div></div></section>

                <section id="resources" class="home-section soft resources"><div class="mouser-shell"><div class="section-head"><h2>Content &amp; Resources</h2><a href="#">View All Technical Resources</a></div><div class="circle-row"><t t-foreach="resources" t-as="r"><div class="circle-card"><div class="circle alt resource-circle"><img t-att-src="r['img']" t-att-alt="r['title']" class="resource-circle-img"/></div><h3 t-out="r['title']"/><p t-out="r['desc']"/></div></t></div></div></section>

                <section class="newsletter"><h3>Get the Latest News</h3><div><input placeholder="Enter your Email"/><button>Subscribe</button></div></section>
