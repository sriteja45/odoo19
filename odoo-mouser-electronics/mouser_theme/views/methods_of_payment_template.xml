    <template id="sales_tax_information_page" name="Sales Tax Information">
        <t t-call="website.layout">
            <div id="wrap" class="mouser-homepage mouser-help-page gst-bill-page sales-tax-info-page">
                <t t-call="mouser_theme.mouser_common_header"/>

