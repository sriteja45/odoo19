<odoo>

    <record id="view_patient_monitoring_list" model="ir.ui.view">
        <field name="name">clinic.patient.monitoring.list</field>
        <field name="model">clinic.patient.monitoring</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_name"/>
                <field name="room_id"/>
                <field name="temperature"/>
                <field name="blood_pressure"/>
                <field name="pulse_rate"/>
                <field name="oxygen"/>
                <field name="monitor_time"/>
                <field name="nurse_id"/>
            </list>
        </field>
    </record>

    <record id="view_patient_monitoring_form" model="ir.ui.view">
        <field name="name">clinic.patient.monitoring.form</field>
        <field name="model">clinic.patient.monitoring</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="appointment_id"/>
                        <field name="patient_name" readonly="1"/>
                        <field name="room_id"/>
                        <field name="temperature"/>
                        <field name="blood_pressure"/>
                        <field name="pulse_rate"/>
                        <field name="oxygen"/>
                        <field name="notes"/>
                        <field name="monitor_time" readonly="1"/>
                        <field name="nurse_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_patient_monitoring" model="ir.actions.act_window">
        <field name="name">Patient Monitoring</field>
        <field name="res_model">clinic.patient.monitoring</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>