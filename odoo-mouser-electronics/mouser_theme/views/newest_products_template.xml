                        <nav class="nbc-breadcrumb">
                            <a href="/mouser-home">Home</a>
                            <span>›</span>
                            <a href="/new/products/">Newest Products by Category</a>
                            <span>›</span>
                            <strong t-out="cat_name"/>
                        </nav>

                        <!-- Category hero -->
                        <section class="nbc-cat-hero">
                            <img t-att-src="cat_img" t-att-alt="cat_name" class="nbc-cat-hero-img"/>
                            <div class="nbc-cat-hero-text">
                                <h2 t-out="cat_name"/>
                                <p>Introducing new <span t-out="cat_name.lower()"/> products every day. Mouser is the first choice among design engineers seeking the newest products and latest technologies.</p>
                            </div>
                        </section>

                        <!-- Error -->
                        <t t-if="api_error">
                            <div class="nbc-api-error">
                                <i class="fa fa-exclamation-triangle"></i>
                                <span>Could not load products: <t t-out="api_error"/></span>
                            </div>
                        </t>

                        <!-- Results count -->
                        <div t-if="not api_error" class="nbc-results-bar">
                            <span><strong t-out="total"></strong> results found</span>
                            <span class="nbc-results-page">Page <t t-out="page"/> of <t t-out="total_pages"/></span>
                        </div>

                        <!-- Products table -->
                        <t t-if="products">
                            <div class="nbc-products-table-wrap">
                                <table class="nbc-products-table">
                                    <thead>
                                        <tr>
                                            <th>Image</th>
                                            <th>Mfr. Part No.</th>
                                            <th>Mouser No.</th>
                                            <th>Manufacturer</th>
                                            <th>Description</th>
                                            <th>Availability</th>
                                            <th>Price (INR)</th>
                                            <th>Datasheet</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="products" t-as="prod">
                                            <tr>
                                                <td class="nbc-td-img">
                                                    <t t-if="prod.get('image')">
                                                        <img t-att-src="prod['image']" class="nbc-prod-img" t-att-alt="prod['mpn']"/>
                                                    </t>
                                                    <t t-else=""><span class="nbc-no-img">—</span></t>
                                                </td>
                                                <td class="nbc-td-mpn">
                                                    <a t-att-href="prod.get('detail_url','#')" target="_blank" rel="noopener noreferrer" t-out="prod['mpn']"/>
                                                </td>
                                                <td t-out="prod['mouser_no']"/>
                                                <td t-out="prod['manufacturer']"/>
                                                <td class="nbc-td-desc" t-out="prod['description']"/>
                                                <td t-out="prod['availability']"/>
                                                <td t-out="prod.get('price','')"/>
                                                <td class="nbc-td-ds">
                                                    <t t-if="prod.get('datasheet')">
                                                        <a t-att-href="prod['datasheet']" target="_blank" rel="noopener noreferrer" title="Datasheet">
                                                            <i class="fa fa-file-pdf-o nbc-pdf-icon"></i>
                                                        </a>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            <div t-if="total_pages > 1" class="nbc-pagination">
                                <t t-foreach="range(1, total_pages + 1)" t-as="pg">
                                    <a t-att-href="'/new/products/' + cat_slug + '?page=' + str(pg)"
                                       t-att-class="'nbc-page-btn' + (' nbc-page-active' if pg == page else '')"
                                       t-out="pg"/>
                                </t>
                            </div>
                        </t>

                        <t t-elif="not api_error">
                            <div class="nbc-no-results">No products found for this category.</div>
                        </t>

                    </main>
                </div>

