<odoo>

    <!-- List View -->
    <record id="view_room_booking_list" model="ir.ui.view">
        <field name="name">hospital.room.booking.list</field>
        <field name="model">hospital.room.booking</field>
        <field name="arch" type="xml">
            <list string="Room Bookings">
                <field name="patient_id"/>
                <field name="room_id"/>
                <field name="doctor_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="state"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_room_booking_form" model="ir.ui.view">
        <field name="name">hospital.room.booking.form</field>
        <field name="model">hospital.room.booking</field>
        <field name="arch" type="xml">
            <form string="Room Booking">
                <header>
                    <button name="action_book"
                            string="Book"
                            type="object"
                            invisible="state != 'draft'"/>

                    <button name="action_admit"
                            string="Admit"
                            type="object"
                            invisible="state != 'booked'"/>

                    <button name="action_discharge"
                            string="Discharge"
                            type="object"
                            invisible="state != 'admitted'"/>

                    <button name="action_done"
                            string="Done"
                            type="object"
                            invisible="state != 'discharged'"/>

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="room_id"/>
                        <field name="doctor_id"/>
                        <field name="check_in"/>
                        <field name="check_out"/>
                        <field name="total_amount" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
