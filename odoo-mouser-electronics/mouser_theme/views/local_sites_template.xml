                <section class="mouser-blue-nav">
                    <div class="mouser-shell nav-row">
                        <nav><a href="/mouser-home">Products</a><a href="/manufacturer/">Manufacturers</a><a href="/services-tools">Services &amp; Tools</a><a href="#">Technical Resources</a><a href="#">Help</a></nav>
                        <div class="nav-actions"><a href="#">Account &amp; Orders <i class="fa fa-angle-down"></i></a><a class="cart" href="#"><i class="fa fa-shopping-cart"></i><span>0</span></a></div>
                    </div>
                </section>

                <main class="mouser-shell localsites-main">
                    <div class="localsites-hero">Mouser worldwide</div>
                    <section class="localsites-intro">
                        <h1>Mouser Worldwide</h1>
                        <p>If your location is not listed, please select one of the following:</p>
