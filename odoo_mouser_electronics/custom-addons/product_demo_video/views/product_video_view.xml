<odoo>

<!-- Product Backend -->

<record
id="product_video_form"
model="ir.ui.view">

<field name="name">
product.video.form
</field>

<field name="model">
product.template
</field>

<field
name="inherit_id"
ref="product.product_template_only_form_view"/>

<field
name="arch"
type="xml">

<xpath
expr="//sheet"
position="inside">

<group>

<field
name="demo_video_url"/>

</group>

</xpath>

</field>

</record>


<!-- Website -->

<template
id="website_product_video"
inherit_id="website_sale.product">

<xpath
expr="//div[@id='product_details']"
position="after">

<t t-if="product.demo_video_url">

<h3>
Demo Video
</h3>

<iframe
width="700"
height="400"
frameborder="0"
allowfullscreen="1"
t-att-src="product.demo_video_url"/>

</t>

</xpath>

</template>

</odoo>