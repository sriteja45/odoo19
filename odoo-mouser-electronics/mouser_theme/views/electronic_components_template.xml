                <div class="mouser-shell mcat-products-wrap" t-if="products">
                    <!-- Search within results -->
                    <form t-attf-action="/c/#{category_slug}" method="GET" class="mcat-search-bar">
                        <input type="text" name="keyword" class="mcat-search-input"
                               placeholder="Part No. / Keyword" t-att-value="keyword"/>
                        <button type="submit" class="mcat-search-btn"><i class="fa fa-search"/></button>
                    </form>

                    <table class="mcat-table">
                        <thead>
                            <tr>
                                <th class="mcat-th-check"><input type="checkbox" title="Select All"/></th>
                                <th class="mcat-th-img">Image</th>
                                <th class="mcat-th-part">Part # <span class="mcat-sort-icon">⇅</span></th>
                                <th class="mcat-th-mfr">Mfr. <span class="mcat-sort-icon">⇅</span></th>
                                <th class="mcat-th-desc">Description</th>
                                <th class="mcat-th-ds">Datasheet</th>
                                <th class="mcat-th-avail">Availability</th>
                                <th class="mcat-th-price">
                                    Pricing (INR)
                                    <a href="#" class="mcat-price-help">?</a>
                                </th>
                                <th class="mcat-th-qty">Qty.</th>
                                <th class="mcat-th-rohs">RoHS</th>
                                <th class="mcat-th-ecad">ECAD Model</th>
                                <th class="mcat-th-product">Product</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="products" t-as="p">
                                <tr class="mcat-row">
                                    <td class="mcat-td-check"><input type="checkbox"/></td>
                                    <td class="mcat-td-img">
                                        <img t-if="p.get('image')" t-att-src="p['image']"
                                             class="mcat-prod-img" t-att-alt="p.get('mpn','')" loading="lazy"/>
                                        <div t-else="" class="mcat-no-img"/>
                                    </td>
                                    <td class="mcat-td-part">
                                        <div class="mcat-mouser-pn">
                                            <span class="mcat-pn-label">Mouser Part No</span><br/>
                                            <a t-if="p.get('detail_url')" t-att-href="p['detail_url']"
                                               class="mcat-part-link" t-out="p.get('mouser_no','')"/>
                                            <span t-else="" t-out="p.get('mouser_no','')"/>
                                        </div>
                                        <div class="mcat-mfr-pn" t-out="p.get('mpn','')"/>
                                    </td>
                                    <td class="mcat-td-mfr" t-out="p.get('manufacturer','')"/>
                                    <td class="mcat-td-desc">
                                        <span t-out="p.get('description','')"/>
                                        <a t-if="p.get('detail_url')" t-att-href="p['detail_url']"
                                           class="mcat-learn-more">Learn More</a>
                                    </td>
                                    <td class="mcat-td-ds">
                                        <a t-if="p.get('datasheet')" t-att-href="p['datasheet']"
                                           target="_blank" class="mcat-ds-link">
                                            <i class="fa fa-file-pdf-o"/> PDF
                                        </a>
                                    </td>
                                    <td class="mcat-td-avail" t-out="p.get('availability','')"/>
                                    <td class="mcat-td-price">
                                        <t t-if="p.get('price')">
                                            <div class="mcat-price-row">
                                                <span class="mcat-price-qty">1</span>
                                                <span class="mcat-price-val" t-out="p.get('price','')"/>
                                            </div>
                                        </t>
                                    </td>
                                    <td class="mcat-td-qty">
                                        <div class="mcat-qty-wrap">
                                            <input type="number" class="mcat-qty-input" min="1" value="1"/>
                                            <span class="mcat-mult">Mult.: 1</span>
                                        </div>
                                    </td>
                                    <td class="mcat-td-rohs">
                                        <span t-if="p.get('rohs')" class="mcat-rohs-badge" t-out="p.get('rohs','')"/>
                                    </td>
                                    <td class="mcat-td-ecad"></td>
                                    <td class="mcat-td-product"></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Pagination bar -->
                    <div class="mcat-pagination-bar" t-if="total_pages > 1">
                        <a t-if="page > 1"
                           t-attf-href="/c/#{category_slug}?keyword=#{keyword}&amp;page=#{page-1}"
                           class="mcat-pgbtn">‹</a>
                        <t t-set="p_start" t-value="[1, page - 2][page > 2]"/>
                        <t t-set="p_end" t-value="[total_pages, page + 2][page + 2 &lt; total_pages]"/>
                        <t t-foreach="range(max(1, page-2), min(total_pages+1, page+3))" t-as="pg">
                            <a t-attf-href="/c/#{category_slug}?keyword=#{keyword}&amp;page=#{pg}"
                               t-att-class="'mcat-pgbtn mcat-pgbtn-active' if pg == page else 'mcat-pgbtn'"
                               t-out="pg"/>
                        </t>
                        <span t-if="total_pages > page + 3" class="mcat-pg-ellipsis">»</span>
                        <a t-if="page &lt; total_pages"
                           t-attf-href="/c/#{category_slug}?keyword=#{keyword}&amp;page=#{page+1}"
                           class="mcat-pgbtn">›</a>
                    </div>
                </div>

                <div t-if="not products and not error" class="mouser-shell mcat-no-results">
                    No products found for "<t t-out="keyword"/>".
                </div>

                <!-- ── Newsletter section ── -->
