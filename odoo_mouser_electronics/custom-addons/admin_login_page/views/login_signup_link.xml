<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="login_create_account_link"
              inherit_id="web.login">

        <xpath expr="//form" position="inside">

            <div class="text-center mt-3">

                <p>
                    Don't have an account?
                </p>

                <a href="/web/signup"
                   class="btn btn-outline-primary">
                    Create an Account
                </a>

            </div>

        </xpath>

    </template>

</odoo>