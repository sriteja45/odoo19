<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_review_request" model="ir.ui.view">
        <field name="name">sale.order.form.review.request</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_send_review_request" type="object"
                        class="oe_stat_button" icon="fa-star"
                        invisible="state != 'sale'">
                    <field name="review_request_count" widget="statinfo" string="Review Requests"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
