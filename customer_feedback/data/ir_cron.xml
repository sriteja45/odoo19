<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_process_feedback_requests" model="ir.cron">
        <field name="name">Customer Feedback: Send Invitations &amp; Expire Requests</field>
        <field name="model_id" ref="model_feedback_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_feedback_requests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_send_feedback_reminders" model="ir.cron">
        <field name="name">Customer Feedback: Send Review Reminders</field>
        <field name="model_id" ref="model_feedback_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
