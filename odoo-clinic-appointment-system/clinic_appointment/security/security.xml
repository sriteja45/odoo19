<odoo>
    <data>

        

        <!-- ============================= -->
        <!-- DOCTOR -->
        <!-- ============================= -->

        <record id="group_clinic_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_doctor_extra_access" model="res.groups">
            <field name="name">Doctor Extra Access</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- ============================= -->
        <!-- RECEPTIONIST -->
        <!-- ============================= -->

        <record id="group_clinic_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_receptionist_extra_access" model="res.groups">
            <field name="name">Receptionist Extra Access</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- ============================= -->
        <!-- NURSE -->
        <!-- ============================= -->

        <record id="group_clinic_nurse" model="res.groups">

            <field name="name">Nurse</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>

        </record>

        <record id="group_nurse_extra_access" model="res.groups">
            <field name="name">Nurse Extra Access</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- ============================= -->
        <!-- LAB TECHNICIAN -->
        <!-- ============================= -->

        <record id="group_clinic_lab" model="res.groups">
            <field name="name">Lab Technician</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_lab_extra_access" model="res.groups">
            <field name="name">Lab Technician Extra Access</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- ============================= -->
        <!-- PHARMACIST -->
        <!-- ============================= -->

        <record id="group_clinic_pharmacist" model="res.groups">
            <field name="name">Pharmacist</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_pharmacist_extra_access" model="res.groups">
            <field name="name">Pharmacist Extra Access</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_clinic_housekeeping" model="res.groups">
            <field name="name">Housekeeping</field>
        </record>

        <record id="group_housekeeping_extra_access" model="res.groups">
            <field name="name">Housekeeping</field>
        </record>


        <!-- Doctor can only see their own appointments -->

        <record id="clinic_doctor_appointment_rule" model="ir.rule">
            <field name="name">Doctor Own Appointments</field>
            <field name="model_id" ref="model_clinic_appointment"/>
            <field name="domain_force">[('doctor_user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('clinic_appointment.group_clinic_doctor'))]"/>
        </record>
    
        <!-- Receptionist can see all appointments -->

        <record id="clinic_receptionist_appointment_rule" model="ir.rule">
            <field name="name">Receptionist All Appointments</field>
            <field name="model_id" ref="model_clinic_appointment"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('clinic_appointment.group_clinic_receptionist'))]"/>
        </record>

        <!-- Nurse can see all appointments -->

        <record id="clinic_nurse_appointment_rule" model="ir.rule">
            <field name="name">Nurse All Appointments</field>
            <field name="model_id" ref="model_clinic_appointment"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('clinic_appointment.group_clinic_nurse'))]"/>
        </record>

    </data>

</odoo>
