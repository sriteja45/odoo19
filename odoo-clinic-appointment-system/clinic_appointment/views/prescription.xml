<odoo>
    <record id="view_prescription_form" model="ir.ui.view">
        <field name="name">clinic.prescription.form</field>
        <field name="model">clinic.prescription</field>
        <field name="arch" type="xml">

            <form>
                <sheet>

                    <group>
                        <field name="patient_name"/>
                        <field name="doctor_id"/>
                        <field name="date"/>
                    </group>

                    <group>
                        <field name="medicine_ids"/>
                        <field name="dosage"/>
                        <field name="notes"/>
                    </group>

                </sheet>
            </form>

        </field>
    </record>
</odoo>