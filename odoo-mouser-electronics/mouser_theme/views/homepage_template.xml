                                <img src="/mouser_theme/static/img/logo-nfsb_small.webp" alt="Customer Service"/>
                                <img src="/mouser_theme/static/img/logo-IESA_small.webp" alt="IESA"/>
                                <img src="/mouser_theme/static/img/logo-ISO14001_small.png" alt="ISO 14001"/>
                                <img src="/mouser_theme/static/img/logo-as9120b_small.webp" alt="AS9120B"/>
                                <img src="/mouser_theme/static/img/logo-esd_small.webp" alt="ESD"/>
