<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ir_cron_currency_rate_update" model="ir.cron">

        <field name="name">Automatic Currency Rate Update</field>

        <field name="model_id" ref="model_currency_rate_update"/>

        <field name="state">code</field>

        <field name="code">model.update_currency_rates()</field>

        <field name="interval_number">1</field>

        <field name="interval_type">days</field>

        <field name="active">True</field>

    </record>

</odoo>