<odoo>
    <record id="view_lab_test_form" model="ir.ui.view">
        <field name="name">clinic.lab.test.form</field>
        <field name="model">clinic.lab.test</field>
        <field name="arch" type="xml">
            <form string="Lab Test Request">

                <header>
                    <!-- Collect Sample button -->
                    <button name="action_collect_sample"
                            type="object"
                            string="Collect Sample"
                            class="btn-success"
                            groups="clinic_appointment.group_clinic_lab"
                            invisible="status != 'requested'"/>

                    <!-- Mark Completed button -->
                    <button name="action_complete_test"
                            type="object"
                            string="Mark Completed"
                            class="btn-success"
                            groups="clinic_appointment.group_clinic_lab"
                            invisible="status != 'processing'"/>

                    <!-- Status bar -->
                    <field name="status"
                        widget="statusbar"
                        statusbar_visible="requested,processing,completed"/>
                </header>

                <sheet>
                    <group string="Basic Info">
                        <field name="category"/>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="test_id"/>
                        <field name="priority"/>
                        <field name="appointment_id" invisible="1"/>
                        <field name="patient_name" readonly="1"/>
                        <field name="doctor_id" readonly="1"/>
                        
                    </group>

                    <group>
                        <field name="currency_id"/>
                        <field name="price"/>
                        <div class="text-muted">
                            Enter test cost
                        </div>
                    </group>

                    <notebook>
                        <page string="Sample Details">
                            <group>
                                <field name="sample_collected"/>
                                <field name="remarks"/>
                            </group>
                        </page>

                        <page string="Lab Report">
                            <group>
                                <field name="report"/>
                                <field name="report_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>
    <!-- SEARCH VIEW -->
    <record id="view_lab_test_search" model="ir.ui.view">
        <field name="name">clinic.lab.test.search</field>
        <field name="model">clinic.lab.test</field>
        <field name="arch" type="xml">
            <search string="Lab Tests">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="doctor_id"/>
                <field name="name"/>
                
                
                
                
                <separator/>
                <filter name="filter_requested" string="Requested" domain="[('status','=','requested')]"/>
                <filter name="filter_processing" string="Processing" domain="[('status','=','processing')]"/>
                <filter name="filter_completed" string="Completed" domain="[('status','=','completed')]"/>
                <filter name="filter_urgent" string="Urgent" domain="[('priority','=','urgent')]"/>
            </search>
        </field>
    </record>

    <!-- LAB TEST REQUESTS ACTION -->
    <record id="action_lab_tests" model="ir.actions.act_window">
        <field name="name">Lab Test Requests</field>
        <field name="res_model">clinic.lab.test</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_template', '=', False)]</field>
        <field name="search_view_id" ref="view_lab_test_search"/>
    </record>

    <record id="action_lab_test_templates" model="ir.actions.act_window">
        <field name="name">Lab Test Master</field>
        <field name="res_model">clinic.lab.test</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_template', '=', True)]</field>
    </record>
</odoo>